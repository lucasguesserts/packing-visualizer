{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema of instances of the Single Large Object Placement Problem",
  "description": "Json Schema describing the input format of the Single Large Object Placement Problem (SLOPP).",
  "type": "object",
  "required": [
    "type",
    "version",
    "large_object",
    "small_items"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "input"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.7\\.0$"
    },
    "large_object": {
      "type": "object",
      "required": [
        "measurement"
      ],
      "additionalProperties": false,
      "properties": {
        "measurement": {
          "$ref": "#/$defs/3D-measurement"
        },
        "constraint": {
          "$ref": "#/$defs/large-object-related-constraints"
        }
      }
    },
    "small_items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/small-item"
      }
    }
  },
  "$defs": {
    "profit": {
      "type": "integer"
    },
    "quantity": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "measurement": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "orientation": {
      "type": "boolean"
    },
    "weight": {
      "type": "integer",
      "minimum": 0
    },
    "3D-measurement": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/measurement"
        },
        "y": {
          "$ref": "#/$defs/measurement"
        },
        "z": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "3D-orientation": {
      "type": "object",
      "required": [
        "xyz",
        "yxz",
        "zyx",
        "xzy",
        "zxy",
        "yzx"
      ],
      "additionalProperties": false,
      "properties": {
        "xyz": {
          "const": true
        },
        "yxz": {
          "$ref": "#/$defs/orientation"
        },
        "zyx": {
          "$ref": "#/$defs/orientation"
        },
        "xzy": {
          "$ref": "#/$defs/orientation"
        },
        "zxy": {
          "$ref": "#/$defs/orientation"
        },
        "yzx": {
          "$ref": "#/$defs/orientation"
        }
      }
    },
    "multi-drop-constraint": {
      "type": "object",
      "required": [
        "destination"
      ],
      "additionalProperties": false,
      "properties": {
        "destination": {
          "type": "integer"
        }
      }
    },
    "small-item": {
      "type": "object",
      "required": [
        "profit",
        "quantity",
        "measurement"
      ],
      "additionalProperties": false,
      "properties": {
        "profit": {
          "$ref": "#/$defs/profit"
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "measurement": {
          "$ref": "#/$defs/3D-measurement"
        },
        "constraint": {
          "$ref": "#/$defs/item-related-constraints"
        }
      }
    },
    "item-related-constraints": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "$ref": "#/$defs/3D-orientation"
        },
        "weight": {
          "$ref": "#/$defs/weight"
        },
        "multi_drop": {
          "$ref": "#/$defs/multi-drop-constraint"
        }
      }
    },
    "large-object-related-constraints": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "weight_limit": {
          "$ref": "#/$defs/weight"
        },
        "weight_distribution": {
          "$ref": "#/$defs/large-object-weight-distribution-constraint"
        }
      }
    },
    "large-object-weight-distribution-constraint": {
      "type": "object",
      "required": [
        "model",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z_]+$"
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
